# Supabase Configuration
# Copy this file to .env and fill in your actual values

# Public API credentials (used by React/Vite frontend)
VITE_SUPABASE_URL=your_supabase_project_url
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key

# Service role key (SEEDING ONLY - NEVER expose to frontend)
# ⚠️ IMPORTANT: This key bypasses all RLS policies. Keep it secret!
# Only needed when running: npm run seed
# Get from Supabase Dashboard > Settings > API > service_role key
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key
